# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Facts Store
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_RETRY_ATTEMPTS=3

# PDF processing
MAX_UPLOAD_BYTES=104857600
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=300
PARSER_VERSION=pymupdf-1
FACT_EXTRACTION_CONCURRENCY=3
FACT_EXTRACTION_PAGE_BATCH_SIZE=4
FACTS_PER_PAGE_LIMIT=8

# Embeddings and relationship discovery
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=90
EMBEDDING_ITEMS_PER_MINUTE=90
CANDIDATES_PER_FACT=8
MIN_CANDIDATE_SIMILARITY=0.55
MIN_LLM_RELATIONSHIP_SIMILARITY=0.82
MAX_LLM_RELATIONSHIPS_PER_DOCUMENT=12

# Browser access
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
