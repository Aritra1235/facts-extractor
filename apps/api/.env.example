DATABASE_URL=postgresql+asyncpg://facts:facts@localhost:5433/facts
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=104857600
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=300
PARSER_VERSION=pymupdf-1
EMBEDDING_DIMENSIONS=384
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
FACT_EXTRACTION_CONCURRENCY=3
FACT_EXTRACTION_PAGE_BATCH_SIZE=4
FACTS_PER_PAGE_LIMIT=8
EMBEDDING_BATCH_SIZE=90
EMBEDDING_ITEMS_PER_MINUTE=90
CANDIDATES_PER_FACT=8
MIN_CANDIDATE_SIMILARITY=0.55
MIN_LLM_RELATIONSHIP_SIMILARITY=0.82
MAX_LLM_RELATIONSHIPS_PER_DOCUMENT=12
GEMINI_TIMEOUT_MS=60000
GEMINI_RETRY_ATTEMPTS=3
